{
  "version": 2,
  "buildCommand": "node scripts/bump-version.js",
  "outputDirectory": ".",
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/js/(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/psi/:slug", "destination": "https://serenecare-backend-production.up.railway.app/api/perfil-publico/:slug" },
    { "source": "/hablalo/autor/:slug", "destination": "https://serenecare-backend-production.up.railway.app/api/hablalo/autor/:slug" },
    { "source": "/hablalo/articulo/:slug", "destination": "https://serenecare-backend-production.up.railway.app/api/hablalo/articulo/:slug" },
    { "source": "/hablalo/buscar", "destination": "https://serenecare-backend-production.up.railway.app/api/hablalo/buscar" },
    { "source": "/hablalo/explorar", "destination": "https://serenecare-backend-production.up.railway.app/api/hablalo/explorar" },
    { "source": "/hablalo/tema/:slug", "destination": "https://serenecare-backend-production.up.railway.app/api/hablalo/tema/:slug" },
    { "source": "/hablalo/reservar/:slug", "destination": "https://serenecare-backend-production.up.railway.app/api/hablalo/reservar/:slug" },
    { "source": "/hablalo/mi-espacio", "destination": "/screens/hablalo_mi_espacio.html" },
    { "source": "/hablalo/ajustes", "destination": "/screens/hablalo_ajustes.html" },
    { "source": "/hablalo/empezar", "destination": "/screens/hablalo_empezar.html" },
    { "source": "/hablalo", "destination": "https://serenecare-backend-production.up.railway.app/api/hablalo/home" },
    { "source": "/mx", "destination": "https://serenecare-backend-production.up.railway.app/api/seo/mx-index" },
    { "source": "/mx/:path*", "destination": "https://serenecare-backend-production.up.railway.app/api/seo/pagina/mx/:path*" },
    { "source": "/directorio", "destination": "https://serenecare-backend-production.up.railway.app/api/directorio" },
    { "source": "/sitemap-psicologos.xml", "destination": "https://serenecare-backend-production.up.railway.app/api/perfil-publico/sitemap.xml" },
    { "source": "/api/:path*", "destination": "https://serenecare-backend-production.up.railway.app/api/:path*" },
    { "source": "/acceso", "destination": "/acceso.html" },
    { "source": "/empresas", "destination": "/empresas.html" },
    { "source": "/hablalo/test", "destination": "/hablalo.html" },
    { "source": "/hablalo-admin", "destination": "/screens/hablalo_admin.html" },
    { "source": "/hablalo-autor", "destination": "/screens/hablalo_autor.html" },
    { "source": "/hablalo/entrar", "destination": "/screens/hablalo_entrar.html" },
    { "source": "/hablalo/soy-psicologo", "destination": "/screens/hablalo_registro_psicologo.html" },
    { "source": "/seo", "destination": "/seo-panel.html" },
    { "source": "/sala", "destination": "/seo-sala.html" },
    { "source": "/creadores", "destination": "/screens/creadores.html" },
    { "source": "/panel", "destination": "/screens/panel_creador.html" },
    { "source": "/registro", "destination": "/screens/registro_clinica.html" },
    { "source": "/herramientas/phq9", "destination": "/herramientas/phq9.html" },
    { "source": "/herramientas", "destination": "/herramientas/phq9.html" },
    { "source": "/screens/:path*", "destination": "/screens/:path*" }
  ],
  "redirects": [
    { "source": "/r/:code", "destination": "/screens/registro_clinica.html?ref=:code", "permanent": false },
    { "source": "/index.html", "destination": "/", "permanent": true }
  ]
}
